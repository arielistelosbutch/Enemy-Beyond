const VYSTROJ := "VOJENSKÁ DATABÁZE - PROJEKT X\nOznačení: STANDARDNÍ BOJOVÁ VÝSTROJ UAI. Klasifikace: Osobní ochranná výstroj pozemních jednotek. Typ: Lehká modulární bojová zbroj. Výrobce: Vojenský vývojový program Projekt X. Status: Standardní výbava operativců UAI.\n\nPOPIS VÝSTROJE: Standardní bojová výstroj UAI představuje základní ochranný systém vojáků nasazovaných v rámci Projektu X. Byla navržena s důrazem na pohyblivost, modularitu a ochranu proti konvenčním i mimozemským zbraním.\nZákladem je odolná vojenská kombinéza doplněná soustavou lehkých pancéřových plátů, které chrání nejdůležitější části těla, aniž by výrazně omezovaly pohyb vojáka.\nAčkoliv poskytuje spolehlivou ochranu proti střepinám a části běžných balistických hrozeb, její účinnost proti pokročilým mimozemským energetickým zbraním zůstává omezená.\n\nKONSTRUKCE A OCHRANA:\n- Hrudní pancíř: Kompozitní ochranný plát určený k ochraně životně důležitých orgánů. Integrovaný identifikační světelný prvek umožňuje rozpoznání spojeneckých jednotek.\n- Bojová přilba: Lehká balistická přilba s komunikační soupravou a možností připojení dodatečných senzorů nebo nočního vidění.\n- Ochrana končetin: Samostatné pancéřové segmenty chránící ramena, kolena a předloktí. Konstrukce upřednostňuje pohyblivost před maximálním pancéřováním.\n- Taktický batoh: Modulární úložný systém označený symbolem X, určený k přepravě munice, zdravotnického materiálu a specializovaného vybavení.\n- Identifikace UAI: Charakteristická nášivka na rameni označující příslušnost k mezinárodním obranným silám Projektu X.\n\nSTANDARDNÍ VÝBAVA:\n- Osobní zbraň: Standardní útočná puška dle bojového zařazení vojáka.\n- Komunikace: Šifrované rádiové spojení s velitelstvím a ostatními členy družstva.\n- Zdravotnická výbava: Individuální lékárnička pro základní ošetření v bojových podmínkách.\n- Taktické prostředky: Granáty, dodatečná munice a specializované vybavení podle charakteru mise.\n- Polní systém: Základní navigační a identifikační zařízení pro koordinaci pohybu jednotek.\n\nTAKTICKÉ HODNOCENÍ:\n- Výhody: Nízká hmotnost, dobrá pohyblivost, modulární konstrukce, snadná údržba, možnost budoucích technologických vylepšení.\n- Nevýhody: Omezená ochrana proti plazmovým a energetickým zbraním, nedostatečná odolnost vůči mimozemským biologickým útokům, absence aktivních obranných systémů.\n- Doporučené použití: Standardní pěchotní operace, průzkum, zajišťování objektů a boj proti lehkým mimozemským jednotkám.\n\nZÁVĚREČNÉ HODNOCENÍ: \"Tohle je to nejlepší, co v současnosti dokážeme našim vojákům nabídnout. Je to lehké, spolehlivé a umožňuje jim bojovat bez zbytečného omezení pohybu. Ale nedělejme si iluze. Proti zbraním, které ti zatracení cizáci používají, je to pořád jen kus pancíře. Potřebujeme jejich technologie. Potřebujeme pochopit jejich materiály. A hlavně potřebujeme čas, abychom z našich vojáků přestali dělat snadné cíle. Do té doby jim nezbývá nic jiného než dobrý výcvik, spolehlivá puška a trochu štěstí.\"\n— Vedoucí výzbrojního oddělení Projektu X, interní zpráva UAI"
const SOUD := ["Konečný soud", "VOJENSKÁ DATABÁZE - PROJEKT X\nHISTORICKÝ ARCHIV UAI - POČÁTEK INVAZE\nHistorický záznam: PROJEKT X - POSLEDNÍ OBRANNÁ LINIE LIDSTVA.\nOficiální označení: UNITED ARMIES INITIATIVE - PROJECT X.\nArchivní klasifikace: Historie organizace, první kontakt a počátek mimozemské invaze.\nOznačení dokumentu: X-ARC-001.\nStupeň utajení: PŘÍSNĚ TAJNÉ - OMEGA.\nPůvodní účel projektu: Strategická obrana proti jadernému napadení.\nSoučasný účel projektu: Organizovaný vojenský odpor proti mimozemské invazi.\nDatum prvního kontaktu: 21. dubna 1990.\nDatum zahájení otevřeného konfliktu: 23. dubna 1990.\nStatus: AKTIVNÍ - VÁLEČNÝ STAV.\nOperační organizace: United Armies Initiative (UAI).\n\nÚVODNÍ HISTORICKÝ ZÁZNAM: Dne 21. dubna 1990 se lidská historie navždy změnila.\nToho dne se nad pouštní oblastí amerického státu Nové Mexiko objevil neidentifikovaný létající objekt.\nPrvní vojenská pozorování naznačovala přítomnost neznámého letounu.\nRadarové záznamy však brzy odhalily skutečnost, která odporovala všem známým schopnostem tehdejších leteckých technologií.\nObjekt dokázal udržovat stabilní polohu bez viditelných prostředků pohonu.\nJeho konstrukce neodpovídala žádnému známému vojenskému ani civilnímu letadlu.\nNereagoval na standardní výzvy řízení letového provozu.\nA přesto nevykazoval žádné známky nepřátelského chování.\nPo několika hodinách pozorování začal pomalu sestupovat.\nNakonec přistál v odlehlé pouštní oblasti nedaleko Nového Mexika.\nNa místo byly okamžitě vyslány americké vojenské jednotky.\nOblast byla uzavřena a přístup civilního obyvatelstva omezen.\nVojenské velení předpokládalo možnost utajeného technologického experimentu nebo neznámého zahraničního letounu.\nTato vysvětlení však přestala být relevantní ve chvíli, kdy se na trupu objektu otevřel vstupní mechanismus.\nZ plavidla vystoupilo několik humanoidních bytostí.\nByly malé.\nŠtíhlé.\nMěly nepřirozeně velké hlavy, úzká ústa a charakteristické černé oči.\nJejich vzhled nápadně připomínal popisy bytostí, které se po desetiletí objevovaly v populární kultuře a neověřených svědectvích.\nPozději dostaly oficiální označení:\n\nŠEDIVÁCI\n\nPoprvé v zaznamenané historii lidstvo stálo tváří v tvář potvrzeným návštěvníkům z jiného světa.\nA celý svět se na několik okamžiků zastavil.\n\n21. DUBNA 1990 – DEN PRVNÍHO KONTAKTU: Zprávy o mimozemském přistání se začaly šířit prakticky okamžitě.\nPřestože se americké vojenské velení zpočátku pokoušelo omezit přístup k informacím, přítomnost neznámého plavidla nebylo možné dlouhodobě utajit.\nBěhem několika hodin se první záběry dostaly do televizních stanic.\nNásledně se k mimořádné události začali vyjadřovat představitelé světových mocností.\nZprvu panovala značná nedůvěra.\nMnozí se domnívali, že jde o podvod, neznámý vojenský experiment nebo rozsáhlou propagandistickou operaci.\nPoté však byly zveřejněny první oficiální záběry mimozemských bytostí.\nPochybnosti začaly ustupovat.\nNěco takového nedokázal nikdo přesvědčivě vysvětlit.\nReakce veřejnosti\nPrvní reakce civilního obyvatelstva byly překvapivě pozitivní.\nZatímco část lidí propadala strachu, mnohem větší pozornost médií přitahovala představa mírového setkání dvou civilizací.\nPo desetiletích studené války, jaderného zbrojení a politického napětí se zdálo, že lidstvo konečně stojí před událostí, která by mohla všechny jeho dosavadní konflikty učinit bezvýznamnými.\nLidé začali mluvit o nové éře.\nO budoucnosti bez válek.\nO technologiích, které odstraní nemoci, hlad a energetickou závislost.\nO možnosti cestovat ke hvězdám.\nVědecká komunita očekávala největší technologický průlom v lidských dějinách.\nNáboženské organizace svolávaly mimořádná jednání.\nPolitici začali hovořit o sjednocení lidstva.\nA světové televizní stanice nepřetržitě vysílaly záběry malých šedivých bytostí, které klidně stály před svým plavidlem.\nNikdo zatím netušil, jak krátce tento optimismus potrvá.\nPrvní komunikace\nMimozemští návštěvníci projevili ochotu zahájit kontakt s lidskými představiteli.\nJejich komunikace však byla výrazně odlišná od běžné lidské řeči.\nZpočátku nebylo zcela zřejmé, zda vůbec využívají hlasový jazyk.\nProstřednictvím opakovaných pokusů a specializovaných komunikačních zařízení se podařilo navázat základní výměnu informací.\nPrvní sdělení mimozemských návštěvníků byla krátká.\nVykazovala snahu o navázání oficiálních vztahů.\nA obsahovala jednu neobyčejně zvláštní poznámku.\nPři otázce, proč si pro přistání vybrali právě oblast Nového Mexika, údajně zazněla odpověď:\n\"Protože právě zde jste nás již jednou našli.\"\nPředstavitelé diplomatické delegace tehdy nedokázali význam tohoto tvrzení spolehlivě objasnit.\nNěkteří jej spojovali se staršími příběhy o neidentifikovaných létajících objektech.\nJiní se domnívali, že jde o chybu v překladu.\nOficiální stanovisko uvádělo, že neexistuje žádný potvrzený důkaz o předchozím mimozemském kontaktu.\nTato otázka nebyla během následujících jednání uspokojivě vysvětlena.\n\n22. DUBNA 1990 – DEN NADĚJE: Druhý den mimozemského kontaktu probíhal ve znamení mimořádného diplomatického úsilí.\nDo Spojených států dorazili představitelé několika významných světových mocností.\nByla vytvořena mezinárodní vyjednávací delegace, jejímž úkolem bylo zjistit záměry mimozemských návštěvníků a připravit podmínky pro další spolupráci.\nJednání byla přenášena prostřednictvím televizních sítí do celého světa.\nZáběry diplomatů sedících naproti mimozemským bytostem se okamžitě staly symbolem nové éry.\nTechnologická očekávání\nVelká část diskusí se soustředila na možnosti budoucí spolupráce.\nLidská delegace projevovala zájem především o mimozemský pohon, energetické zdroje a lékařské technologie.\nMimozemšťané odpovídali zdrženlivě.\nNepředložili žádné konkrétní technické plány ani plně funkční technologické vzorky.\nOpakovaně však naznačovali, že lidstvo může v budoucnu získat přístup k poznatkům, které zásadně změní jeho civilizaci.\nPolitická atmosféra\nVeřejnost očekávala podpis historické dohody.\nV mnoha městech se shromažďovaly davy lidí sledujících živé televizní přenosy.\nNa náměstích se objevovaly transparenty vítající mimozemské návštěvníky.\nPolitické komentáře hovořily o konci lidské izolace ve vesmíru.\nVědci plánovali mezinárodní výzkumné programy.\nEkonomové spekulovali o budoucím dopadu mimozemských technologií.\nA armádní představitelé začali diskutovat o tom, zda by kontakt s vyspělejší civilizací mohl definitivně ukončit hrozbu globální jaderné války.\nNaděje byla téměř hmatatelná.\nPřesto existovaly určité varovné signály.\nPrvní pochybnosti\nNěkteří členové bezpečnostních služeb upozorňovali na neobvyklé chování návštěvníků.\nMimozemšťané se zdáli být zvláštně nezaujatí lidskými návrhy.\nJejich reakce byly přesné, ale často velmi stručné.\nNeprojevovali téměř žádné emoce.\nA při některých otázkách se obraceli k jedinému členu vlastní delegace, jehož vybavení se mírně odlišovalo od ostatních.\nTehdy tomu nikdo nepřikládal zásadní význam.\nPozdější výzkum však naznačil, že šlo pravděpodobně o velitelského představitele mimozemské skupiny.\nBezpečnostní analytici rovněž upozornili na skutečnost, že mimozemští návštěvníci nikdy neposkytli jednoznačné informace o velikosti své flotily.\nAni o své domovské planetě.\nAni o skutečném důvodu příletu.\nDiplomaté tato varování zaznamenali.\nJednání však pokračovala.\nSvět chtěl věřit v mír.\n\n23. DUBNA 1990 – DEN KONEČNÉHO SOUDU: Třetí den kontaktu měl být vyvrcholením historického diplomatického jednání.\nPodle připraveného programu měly být projednány základní podmínky budoucích vztahů mezi lidstvem a mimozemskou civilizací.\nV médiích se hovořilo o možném podpisu prvního meziplanetárního memoranda.\nVysílání začalo v obvyklém režimu.\nDiplomaté seděli u jednacího stolu.\nMimozemská delegace zaujímala svá místa naproti nim.\nKamery přenášely obraz do celého světa.\nNa miliony televizních obrazovek dopadal stejný obraz.\nHistorický okamžik.\nPrvní skutečné jednání lidstva s obyvateli jiného světa.\nA potom se všechno změnilo.\nIncident během zasedání\nBěhem běžného průběhu jednání jeden ze Šediváků náhle vstal.\nJeho chování zpočátku nevzbudilo větší pozornost.\nNásledně však vytáhl neznámé zařízení, které pozdější analýza identifikovala jako mimozemskou energetickou zbraň.\nNež stačil kdokoliv z bezpečnostního personálu zareagovat, namířil zbraň na jednoho z lidských diplomatů.\nNásledoval jediný výstřel.\nDiplomat byl zasažen do hlavy.\nZemřel na místě.\nCelý incident proběhl v přímém televizním přenosu.\nZpočátku nikdo nedokázal pochopit, co se právě stalo.\nOzvaly se výkřiky.\nČlenové bezpečnostní služby začali vytahovat zbraně.\nNěkteří diplomaté se pokoušeli dostat do úkrytu.\nJiní zůstali nehybně sedět.\nKameramani pokračovali v natáčení.\nA mimozemská delegace nevykazovala žádné známky paniky.\nŠedivák, který vystřelil, zůstal stát.\nPotom zaznělo sdělení.\nKrátké.\nJednoznačné.\nBez jakékoliv možnosti dalšího vyjednávání.\n\n\"VYJEDNÁVÁNÍ SKONČILO. PATŘÍTE NÁM.\"\n\nPřenos byl krátce nato přerušen.\nTřetí den kontaktu vstoupil do historie pod označením, které mu později přisoudili přeživší diplomaté:\n\nDEN KONEČNÉHO SOUDU\n\nKONEC DIPLOMACIE: Události z 23. dubna 1990 představují definitivní konec prvního pokusu lidstva o mírové navázání vztahů s mimozemskou civilizací.\nV následujících hodinách vypukl po celém světě chaos.\nZáznam vraždy se opakovaně objevoval v televizním vysílání.\nNěkteré stanice jej odmítaly znovu zveřejnit.\nJiné jej přehrávaly nepřetržitě.\nLidé se pokoušeli pochopit, zda šlo o čin jednotlivce, nešťastný incident nebo skutečné vyhlášení války.\nMimozemská delegace však neposkytla žádné další mírové vysvětlení.\nNaopak.\nKrátce po přerušení jednání začaly vojenské radary zaznamenávat další neidentifikované objekty.\nNěkteré se objevily ve vysokých vrstvách atmosféry.\nJiné byly pozorovány nad oceány.\nDalší se začaly přibližovat k významným vojenským objektům.\nV následujících dnech byly zaznamenány první rozsáhlejší střety.\nCivilní letecká doprava začala být omezována.\nVojenské základny přecházely do zvýšené pohotovosti.\nVlády svolávaly mimořádná bezpečnostní jednání.\nA obyvatelstvo, které ještě před několika hodinami vítalo mimozemské návštěvníky, začalo hledat úkryt.\nLidstvo si postupně uvědomovalo, že právě vstoupilo do konfliktu, na který nebylo připraveno.\n\nUNITED ARMIES INITIATIVE – UAI: Zatímco většina světa reagovala na mimozemskou hrozbu improvizovaně, některé státy již disponovaly strukturou, kterou bylo možné využít pro organizovaný odpor.\nTou strukturou byla mezinárodní obranná iniciativa označovaná jako:\n\nUNITED ARMIES INITIATIVE – UAI: UAI vznikla jako utajený projekt vojenské spolupráce vybraných států.\nJejím původním účelem nebyla obrana proti mimozemským civilizacím.\nOrganizace vznikla v prostředí dlouhodobého jaderného napětí a rostoucích obav z možného globálního konfliktu.\nJejí hlavní úkol spočíval v přípravě prostředků, které by umožnily přežití a koordinovanou reakci v případě rozsáhlého jaderného napadení.\nPůvodní obranná doktrína\nUAI se zaměřovala na rozvoj strategické obrany a zachování schopnosti vojenského velení po katastrofickém útoku.\nJejí činnost zahrnovala přípravu zabezpečených vojenských zařízení, systémů včasného varování a utajených komunikačních struktur.\nDůležitou součástí byly rovněž postupy pro udržení provozu klíčových obranných zařízení.\nMezinárodní spolupráce\nDo projektu byly zapojeny vybrané vojenské, technické a vědecké instituce.\nPřesný rozsah spolupráce podléhal přísnému utajení.\nVeřejnost o existenci této struktury nevěděla.\nStrategický význam\nPůvodní UAI nepředstavovala samostatnou světovou armádu.\nŠlo o koordinovanou strukturu, jejímž cílem bylo zajistit společnou obrannou reakci na mimořádně závažnou hrozbu.\nZákladní předpoklad\nCelý systém byl navržen s jednou zásadní myšlenkou.\nPokud dojde ke katastrofě, která překročí schopnosti jednotlivých států, musí existovat organizace schopná koordinovat společnou obranu.\nV dubnu 1990 se ukázalo, že tento předpoklad byl správný.\nPouze hrozba byla úplně jiná.\n\nPROJEKT X – PŮVODNÍ URČENÍ: Projekt X tvořil jednu z nejutajenějších součástí obranné struktury UAI.\nJeho původní koncepce vycházela z potřeby zachovat strategické obranné schopnosti i po rozsáhlém jaderném útoku.\nV rámci projektu byla připravována speciální vojenská a technická infrastruktura.\nTa měla zajistit pokračování velení, obrany a koordinace spojeneckých sil v podmínkách, kdy by běžné státní a vojenské struktury mohly přestat fungovat.\nPodzemní základny\nProjekt počítal s využitím vysoce zabezpečených podzemních komplexů.\nTy měly poskytovat ochranu proti rozsáhlému bombardování a dalším katastrofickým událostem.\nStrategická komunikace\nSoučástí projektu byly systémy umožňující udržování vojenského spojení i při narušení běžné infrastruktury.\nVýzkumná zařízení\nProjekt počítal s vlastními technickými laboratořemi určenými k vývoji obranných prostředků.\nVojenská připravenost\nVybrané jednotky měly být schopny rychlého nasazení během mimořádných bezpečnostních událostí.\nLogistická nezávislost\nPodzemní zařízení měla disponovat vlastními energetickými zdroji a skladovacími kapacitami.\nProjekt X tak představoval mimořádně nákladnou pojistku proti možné katastrofě.\nPojistku, o jejíž existenci vědělo jen velmi omezené množství lidí.\nDne 23. dubna 1990 však získala zcela nový význam.\n\nAKTIVACE PROJEKTU X: Po událostech Dne konečného soudu bylo svoláno mimořádné jednání vrchního velení UAI.\nDosavadní předpoklady mezinárodní bezpečnosti přestaly platit.\nLidstvo již nečelilo možnosti konfliktu mezi jednotlivými státy.\nČelilo mimozemské civilizaci disponující technologiemi, které výrazně překračovaly soudobé lidské možnosti.\nBylo rozhodnuto o okamžité aktivaci Projektu X.\nPůvodní obranná koncepce byla zásadně přepracována.\nZměna operačního určení\nProjekt X již neměl pouze zajišťovat přežití vybraných obranných struktur.\nMěl se stát aktivním nástrojem boje proti mimozemským invazním silám.\nRozšíření vojenského velení\nDo projektu byli povoláni vybraní velitelé, piloti, příslušníci speciálních jednotek a odborníci na strategické plánování.\nVědecká mobilizace\nVýzkumné laboratoře získaly nový úkol.\nAnalyzovat mimozemské technologie.\nOdhalit jejich principy.\nA pokud možno je využít pro potřeby lidstva.\nTechnologické priority\nPůvodní obranné projekty byly přehodnoceny.\nNovou prioritou se stal vývoj prostředků schopných bojovat proti mimozemským plavidlům a pozemním jednotkám.\nUtajení\nVzhledem k rozsahu mimozemské hrozby bylo rozhodnuto zachovat nejdůležitější zařízení Projektu X v přísném utajení.\nJejich odhalení by mohlo umožnit nepříteli zničit jednu z mála organizací schopných koordinované technologické obrany.\nNová doktrína\nProjekt X byl přeměněn z programu strategického přežití na aktivní vojenskou organizaci určenou k obraně Země a vedení ofenzivních operací proti mimozemské invazi.\n\nORGANIZAČNÍ STRUKTURA PROJEKTU X: Projekt X představuje kombinaci vojenské, vědecké a technologické organizace.\nJeho jednotlivé složky musí úzce spolupracovat, protože žádná z nich nedokáže samostatně zajistit účinný odpor proti mimozemským silám.\nVrchní velení\nVrchní velení odpovídá za strategické řízení projektu, přidělování prostředků a koordinaci s organizací UAI.\nRozhoduje o hlavních operačních prioritách a nasazování dostupných sil.\nPozemní jednotky\nPozemní síly Projektu X tvoří vybraní příslušníci speciálních vojenských útvarů.\nJejich úkolem je zasahovat na místech mimozemských útoků, zajišťovat sestřelená plavidla, chránit civilní obyvatelstvo a získávat technologické i biologické vzorky.\nLetecké oddělení\nLetecká složka odpovídá za zachytávání mimozemských plavidel a ochranu vybraných oblastí.\nJejí činnost zahrnuje také průzkum vzdušného prostoru a spolupráci s ostatními vojenskými silami.\nXenotechnologické oddělení\nTato složka provádí analýzu mimozemských zbraní, plavidel, energetických systémů a dalších technologických zařízení.\nJejím hlavním cílem je postupně snižovat technologický náskok nepřítele.\nXenobiologické oddělení\nXenobiologická laboratoř studuje anatomii, fyziologii a biologické vlastnosti mimozemských organismů.\nZískané poznatky jsou využívány k vývoji účinnějších obranných a bojových prostředků.\nXenopsychologické oddělení\nZabývá se chováním inteligentních mimozemských organismů.\nZvláštní význam mají výzkumy živých zajatců a pokusy o pochopení jejich komunikačních schopností.\nTechnické a výrobní oddělení\nVýrobní personál odpovídá za konstrukci, opravy a modernizaci vybavení Projektu X.\nNa základě vědeckých poznatků převádí experimentální technologie do prakticky použitelných systémů.\nLogistické oddělení\nZajišťuje provoz základen, dostupnost materiálu a zásobování vojenských jednotek.\nStrategická analýza\nShromažďuje informace o pohybu mimozemských plavidel a pozemních jednotek.\nVyhodnocuje možné cíle invaze a připravuje podklady pro operační rozhodování.\n\nPOČÁTEČNÍ TECHNOLOGICKÁ SITUACE: Přestože Projekt X disponuje mimořádně kvalitním vybavením, jeho technologická úroveň odpovídá možnostem lidstva roku 1990.\nOrganizace má přístup k moderním radarovým systémům, vojenskému letectvu, řízeným střelám, konvenční pěchotní výzbroji a pokročilým výzkumným zařízením.\nTyto technologie však byly původně navrženy pro boj proti jiným lidským armádám.\nNikoli proti mimozemským organismům a plavidlům využívajícím antigravitační pohon, energetické zbraně a neznámé biologické schopnosti.\nLetecká převaha\nMimozemská plavidla vykazují rychlost a manévrovatelnost, které v některých případech překračují schopnosti nejmodernějších lidských stíhaček.\nPozemní výzbroj\nKonvenční palné zbraně mohou být proti některým mimozemským organismům účinné.\nJejich schopnosti však závisí na druhu cíle a ochranných technologiích nepřítele.\nOchranné prostředky\nStandardní vojenská zbroj nebyla vyvinuta pro střet s plazmovými zbraněmi, biologickými útoky ani psionickým působením.\nVýpočetní technika\nVýzkumná zařízení využívají soudobé počítačové systémy, které umožňují analyzovat značné množství dat.\nJejich výkon je však omezený ve srovnání s mimozemskou technologií.\nVýzkumný potenciál\nNejvětší výhodou Projektu X je schopnost rychle kombinovat vojenské zkušenosti a vědecké poznatky.\nZískávání nepřátelských technologií může postupně umožnit vývoj prostředků, které by jinak lidstvo nedokázalo vytvořit.\nProjekt X nevstupuje do války jako technologicky rovnocenný protivník. Musí se jím teprve stát.\n\nSTRATEGICKÉ CÍLE PROJEKTU X: Po aktivaci organizace byly stanoveny hlavní operační priority.\n1. Ochrana lidstva\nZabránit systematickému ničení civilního obyvatelstva a lidské infrastruktury.\n2. Zachytávání mimozemských plavidel\nOmezovat činnost nepřátelských UFO a získávat jejich technologické komponenty.\n3. Získávání biologických vzorků\nZajišťovat mimozemské organismy pro vědecký výzkum.\n4. Vývoj nových technologií\nVyužívat získané poznatky k modernizaci lidské výzbroje a obranných systémů.\n5. Identifikace invazní hierarchie\nZjistit, kdo mimozemské síly řídí a jakým způsobem jsou jejich operace koordinovány.\n6. Narušení nepřátelské logistiky\nOmezovat schopnost invazních sil doplňovat zásoby a nahrazovat bojové ztráty.\n7. Obrana základen UAI\nZachovat provoz klíčových vojenských a výzkumných zařízení.\n8. Převzetí strategické iniciativy\nPostupně přejít od reaktivní obrany k aktivnímu vyhledávání a likvidaci mimozemských vojenských cílů.\nKonečný cíl\nZastavit mimozemskou invazi, zachovat nezávislost lidské civilizace a odstranit hrozbu jejího podrobení.\n\nDOKTRÍNA VĚDECKÉHO ODPORU: Vedení Projektu X si od počátku uvědomovalo, že konvenční vojenské prostředky nemusí být pro dlouhodobý odpor dostačující.\nZ tohoto důvodu byla přijata nová operační doktrína.\nJejím základem je přímé propojení bojových a vědeckých operací.\nKaždý sestřelený mimozemský stroj představuje možný zdroj technologických poznatků.\nKaždý získaný biologický exemplář může odhalit nové informace o nepříteli.\nKaždý zajatý inteligentní organismus může přispět k pochopení invazního velení.\nA každý úspěšně dokončený výzkum může zvýšit šance lidstva na přežití.\nVojenský postup\nPozemní a letecké jednotky identifikují a zneškodňují nepřátelské cíle.\nZajištění materiálu\nZískané trosky, zařízení a biologické vzorky jsou transportovány do zabezpečených výzkumných komplexů.\nVědecká analýza\nVýzkumný personál se pokouší pochopit principy získaných technologií a vlastnosti nepřátelských organismů.\nTechnologický vývoj\nNové poznatky jsou využívány při návrhu pokročilejší výzbroje a vybavení.\nVýroba\nTechnické oddělení převádí výzkumné výsledky do použitelných prostředků.\nOpětovné nasazení\nModernizované vojenské jednotky se vracejí do boje proti stále nebezpečnějším nepřátelům.\nTento proces musí probíhat nepřetržitě.\nMimozemské invazní síly totiž disponují technologickým náskokem, který nelze překonat jediným objevem.\nKaždá bitva musí lidstvu poskytnout nejen možnost přežít, ale také příležitost naučit se něco, co zvýší jeho šanci v další bitvě.\n\nNEZNÁMÝ NEPŘÍTEL: Na počátku invaze disponuje Projekt X pouze omezenými informacemi o mimozemských silách.\nPřestože byly potvrzeny technologicky vyspělé lodě a inteligentní humanoidní organismy, skutečný rozsah invaze zůstává neznámý.\nNení jasné, zda Šediváci představují jediný mimozemský druh.\nNení známo, zda disponují samostatnou civilizací, nebo jsou součástí většího mezihvězdného uskupení.\nNeznáme přesný počet jejich lodí.\nNeznáme jejich domovskou planetu.\nNeznáme rozsah jejich vojenských rezerv.\nA především neznáme skutečný účel invaze.\nPrvní hypotéza - Kolonizace\nMimozemské síly se mohou pokoušet získat kontrolu nad Zemí jako obyvatelnou planetou.\nDruhá hypotéza - Získávání zdrojů\nInvaze může být motivována přístupem k materiálovým, energetickým nebo biologickým zdrojům.\nTřetí hypotéza - Strategická expanze\nZemě může představovat pouze další cíl rozsáhlejší mimozemské vojenské kampaně.\nČtvrtá hypotéza - Podrobení lidstva\nCílem může být využití lidské civilizace jako pracovní, biologické nebo technologické základny.\nVýzkumný závěr\nŽádná z těchto hypotéz nebyla v počáteční fázi invaze potvrzena.\nZískání dalších informací představuje jednu z hlavních priorit Projektu X.\n\nLIDSTVO NA PRAHU VÁLKY: Události z dubna 1990 ukončily jednu historickou epochu.\nPo desetiletí se lidstvo připravovalo na možnost rozsáhlého konfliktu mezi světovými mocnostmi.\nStáty budovaly jaderné arzenály.\nArmády připravovaly obranné plány.\nPolitici vyjednávali o rovnováze sil.\nA společnost žila v přesvědčení, že největší hrozba pro lidskou civilizaci pochází od jiných lidí.\nTento předpoklad přestal platit během jediného televizního přenosu.\nZbraň, kterou Šedivák vytáhl před zraky celého světa, neukončila pouze diplomatické jednání.\nSymbolicky ukončila také představu, že lidstvo stojí na vrcholu známého světa.\nNáhle se objevila civilizace disponující prostředky, proti kterým byly nejmodernější lidské zbraně často nedostatečné.\nCivilizace, která neprojevovala zájem o rovnoprávné vztahy.\nA která otevřeně oznámila svůj záměr podrobit si celé lidstvo.\nV reakci na tuto hrozbu byly zahájeny mimořádné vojenské mobilizace.\nJednotlivé státy se pokoušely bránit vlastní území.\nNěkteré dokázaly organizovat účinný odpor.\nJiné utrpěly vážné ztráty již během prvních střetů.\nV takové situaci získala existence Projektu X mimořádný význam.\nNešlo o největší armádu světa.\nNedisponoval neomezenými prostředky.\nNeměl dostatek vojáků ani technologií k okamžitému zastavení invaze.\nAle měl něco, co se ukázalo být nenahraditelné.\nPředem připravenou infrastrukturu.\nMezinárodní spolupráci.\nVysoce kvalifikovaný personál.\nA schopnost soustředit nejlepší dostupné prostředky na jediný cíl.\nPřežití lidské civilizace.\n\nSTRATEGICKÉ ZÁVĚRY HISTORICKÉHO ZÁZNAMU: - Datum prvního kontaktu: 21. dubna 1990.\n- Místo prvního přistání: Nové Mexiko, Spojené státy americké.\n- První potvrzený mimozemský druh: Šedivák.\n- První diplomatická jednání: 21.-23. dubna 1990.\n- Den konečného soudu: 23. dubna 1990.\n- Rozhodující incident: Vražda lidského diplomata mimozemskou energetickou zbraní během přímého televizního přenosu.\n- Poslední veřejné sdělení mimozemské delegace: \"Vyjednávání skončilo, patříte nám.\"\n- Výsledek jednání: Definitivní zhroucení diplomatických vztahů.\n- Bezprostřední důsledek: Zahájení otevřeného konfliktu mezi lidstvem a mimozemskými invazními silami.\n- Existující obranná organizace: United Armies Initiative (UAI).\n- Původní účel Projektu X: Strategická obrana před jaderným napadením.\n- Nový účel Projektu X: Organizovaný vojenský a technologický odpor proti mimozemské invazi.\n- Dostupné prostředky: Nejmodernější konvenční vojenská technika a vysoce kvalifikovaný personál vybraných států.\n- Hlavní nevýhoda lidstva: Značný technologický náskok mimozemských sil.\n- Hlavní výhoda Projektu X: Kombinace vojenských operací, vědeckého výzkumu a technologického vývoje.\n- Strategický cíl: Zastavení mimozemské invaze a zachování nezávislosti lidstva.\n- Konečný operační status: VÁLEČNÝ STAV - AKTIVNÍ ODPOR.\n\nZÁVĚREČNÉ HODNOCENÍ: \"Pamatuji si 21. duben 1990.\nSamozřejmě že si ho pamatuji.\nMyslím, že na ten den nikdy nezapomene nikdo, kdo ho zažil.\nBylo to zvláštní.\nCelý život jsme se připravovali na válku.\nNa Rusy.\nNa Američany.\nNa jaderné bombardování.\nNa konec světa způsobený našimi vlastními zbraněmi.\nA pak jednoho dne přistála v poušti malá létající loď.\nBez křídel.\nBez motorů.\nBez jakéhokoliv vysvětlení.\nA z ní vystoupilo několik malých šedivých bytostí.\nPamatuji si, jak jsem seděl doma před televizí.\nMoje žena přinesla kávu.\nNa obrazovce se objevily první záběry.\nVšichni ti vojáci.\nVědci.\nNovináři.\nA uprostřed několik malých mimozemšťanů.\nMoje žena se mě tehdy zeptala, jestli se bojím.\nŘekl jsem jí, že ne.\nŽe jestli dokázali přiletět přes celý vesmír, možná už dávno překonali potřebu vést války.\nDnes bych si za tu větu nejraději nafackoval.\nAle tehdy jsem jí opravdu věřil.\nVlastně jsme jí věřili všichni.\nCelý svět sledoval ty malé šedivé bytosti a představoval si, co nám mohou nabídnout.\nNové léky.\nNové zdroje energie.\nMožná cestování ke hvězdám.\nMožná dokonce konec všech našich pozemských konfliktů.\nBylo to krásné.\nNa chvíli jsme přestali řešit, kdo má jaké hranice.\nKdo má silnější armádu.\nKdo má víc jaderných hlavic.\nPoprvé jsem měl pocit, že lidstvo možná konečně pochopí, že jsme všichni součástí jediného světa.\nPak přišel třetí den.\nSeděl jsem v kanceláři.\nNa stole jsem měl několik dokumentů týkajících se našeho původního obranného projektu.\nByla to nudná práce.\nPlány podzemních komplexů.\nAnalýzy odolnosti proti bombardování.\nRozpočty.\nLogistické tabulky.\nZkrátka všechno, co člověk potřebuje k přípravě na válku, která možná nikdy nepřijde.\nV rohu kanceláře běžela televize.\nPřímý přenos z diplomatického jednání.\nDiplomaté mluvili.\nTlumočníci pracovali.\nMimozemšťané seděli naproti nim.\nPak jeden z nich vstal.\nNejdřív jsem tomu nevěnoval pozornost.\nMyslel jsem si, že chce něco říct.\nŽe konečně přednese nějaké významné prohlášení.\nA on opravdu něco významného udělal.\nVytáhl zbraň.\nDodnes si pamatuji ten okamžik.\nTen malý pohyb jeho ruky.\nZáblesk.\nA člověka, který se o vteřinu později zhroutil na jednací stůl.\nNejdřív jsem si myslel, že jde o nějakou chybu vysílání.\nMožná film.\nMožná špatný vtip.\nJenže pak začali lidé křičet.\nDiplomaté utíkali.\nBezpečnostní personál se pokoušel zasáhnout.\nA ten šedivý bastard jen stál.\nÚplně klidně.\nPak zazněla ta slova.\n‚Vyjednávání skončilo, patříte nám.‘\nNa chvíli bylo ticho.\nPak obraz zmizel.\nSeděl jsem před tou televizí a nebyl schopný jediného slova.\nMoje žena mi později řekla, že jsem byl úplně bílý.\nAsi měla pravdu.\nProtože v tu chvíli jsem pochopil, že všechno, co jsme si poslední dva dny představovali, byla strašlivá chyba.\nNepřišli nám pomoci.\nNepřišli se podělit o technologie.\nNepřišli jednat o míru.\nPřišli nám oznámit, že už nejsme pány vlastní planety.\nTelefon zazvonil asi deset minut poté.\nVolalo vrchní velení.\nJediná věta.\n‚Aktivujte Projekt X.‘\nZeptal jsem se, jestli tomu rozumím správně.\nProjekt X byl přece určený pro úplně jinou situaci.\nMěl nás chránit před jadernou válkou.\nMěli jsme podzemní základny.\nZabezpečené sklady.\nNouzové komunikační systémy.\nVšechno připravené na konflikt mezi lidmi.\nAle tohle?\nTohle bylo něco úplně jiného.\nNa druhém konci telefonu se ozvalo dlouhé ticho.\nPak mi velitel odpověděl.\n‚Právě proto vás volám.‘\nJeště ten večer jsme začali povolávat personál.\nPiloti.\nInženýři.\nVědci.\nVojáci speciálních jednotek.\nLidé, kteří do té doby často ani netušili, že nějaký Projekt X existuje.\nNajednou měli opustit své dosavadní úkoly a nastoupit do programu, o kterém nesměli nikomu říct.\nVětšina z nich přišla bez váhání.\nNěkteří se ptali, co přesně se od nich očekává.\nJá jsem jim to nedokázal vysvětlit.\nJak také máte vysvětlit člověku, že od zítřka už nebude bránit svou zemi před jinou armádou?\nŽe bude bojovat proti bytostem z jiného světa?\nŽe jeho nejlepší zbraně možná nebudou stačit?\nŽe všechno, co se naučil během vojenského výcviku, může být najednou téměř k ničemu?\nTak jsem jim řekl jediné.\n‚Potřebujeme vás.‘\nA to byla pravda.\nPotřebovali jsme každého schopného pilota.\nKaždého vědce.\nKaždého technika.\nKaždého vojáka, který byl ochotný nastoupit do transportního letadla a odletět do oblasti, odkud se možná nevrátí.\nBěhem několika dní se naše podzemní základny začaly měnit.\nZ místností určených pro strategické plánování vznikala operační centra.\nStaré sklady se přestavovaly na laboratoře.\nHangáry se připravovaly na nové typy letadel.\nDo výzkumných oddělení přicházeli odborníci, kteří před několika týdny ještě řešili běžné vojenské projekty.\nA teď měli zkoumat technologie, které odporovaly všemu, co znali.\nByl v tom chaos.\nObrovský chaos.\nNedostatek materiálu.\nNedostatek personálu.\nNeustálé změny rozkazů.\nTelefony zvonily ve dne v noci.\nA ze všech koutů světa přicházely stále horší zprávy.\nDalší neidentifikované objekty.\nDalší útoky.\nDalší mrtví.\nNaši první piloti se pokoušeli zachytávat mimozemská plavidla.\nVětšinou se vrátili s prázdnou.\nNěkteří se nevrátili vůbec.\nPozemní jednotky hlásily střety s neznámými organismy.\nVědci požadovali další vzorky.\nVelitelé chtěli lepší zbraně.\nA všichni se ptali na totéž.\n‚Dokážeme je zastavit?‘\nNeměl jsem odpověď.\nDodnes ji nemám.\nAle jednu věc jsem pochopil velmi rychle.\nJestli se budeme snažit vést tuhle válku stejně jako všechny předchozí, prohrajeme.\nNemůžeme se spoléhat pouze na počet vojáků.\nNa počet tanků.\nNa množství raket.\nOni mají technologie, které jsou daleko před námi.\nAle nejsou neporazitelní.\nJejich stroje se dají poškodit.\nJejich vojáci mohou zemřít.\nA jejich technologie se dají zkoumat.\nTakže musíme bojovat jinak.\nKaždá mise musí mít smysl.\nKaždý získaný předmět musí být analyzován.\nKaždé jejich plavidlo, které dokážeme sestřelit, nás musí posunout dál.\nKaždý mrtvý mimozemšťan může odhalit něco, co zachrání některého z našich vojáků.\nA každý živý zajatec nám možná pomůže pochopit, kdo tuhle válku vlastně řídí.\nTo je jediná cesta, kterou máme.\nUčit se.\nPřizpůsobovat se.\nA přežít dost dlouho na to, abychom jim jednoho dne dokázali vrátit úder.\nVzpomínám si, že během jedné z prvních porad se mě mladý důstojník zeptal, co vlastně Projekt X znamená.\nJestli je to nějaká zkratka.\nJestli má to písmeno zvláštní význam.\nOdpověděl jsem mu, že původně šlo jen o utajené označení.\nNic víc.\nProjekt, který se nikdy neměl stát veřejně známým.\nProjekt určený pro nejhorší možný scénář.\nJenže teď už pro mě znamená něco jiného.\nX je neznámá.\nV matematice.\nVe vědě.\nV každé rovnici, kterou zatím nedokážeme vyřešit.\nA právě taková je naše situace.\nNevíme, odkud přišli.\nNevíme, kolik jich je.\nNevíme, jak jejich armáda funguje.\nA nevíme, proč se rozhodli podrobit si naši planetu.\nAle budeme hledat odpovědi.\nJednu po druhé.\nA jestli přitom budeme muset rozebrat každou jejich zbraň, prostudovat každého jejich vojáka a sestřelit každou loď, kterou pošlou...\nTak to uděláme.\nProtože 23. dubna 1990 nám oznámili, že jim patříme.\nŽe naše civilizace už nemá právo rozhodovat o vlastní budoucnosti.\nŽe jsme jen další svět, který si mohou vzít.\nMožná mají silnější zbraně.\nMožná mají větší armádu.\nMožná dokážou cestovat mezi hvězdami.\nAle v jedné věci se přepočítali.\nNikdo jim nedal právo rozhodovat o našem osudu.\nA dokud bude existovat jediný voják ochotný bojovat...\nJediný vědec ochotný hledat odpovědi...\nA jediný člověk, který odmítne přijmout jejich nadvládu...\nBudeme pokračovat.\nNe proto, že si myslíme, že vítězství bude snadné.\nAle proto, že žádnou jinou možnost nemáme.\nPřiletěli sem a řekli nám, že jim patříme.\nTeď je na nás, abychom jim dokázali, jak strašně se mýlili.\nVítejte v Projektu X.\"\n— Vrchní velitel Projektu X, archivní projev při aktivaci programu, duben 1990"]
const WHO := ["Kdo stojí za invazí?", "VOJENSKÁ DATABÁZE - PROJEKT X\nSTRATEGICKÝ VÝZKUM MIMOZEMSKÉ INVAZE\nVýzkumný projekt: KDO STOJÍ ZA INVAZÍ?\nKlasifikace: Strategická neuropsionická analýza invazní hierarchie. Označení projektu: X-OMEGA-001. Stupeň utajení: PŘÍSNĚ TAJNÉ - OMEGA. Výzkumné oddělení: Společný výzkumný tým xenobiologie, neuropsioniky a strategického zpravodajství UAI. Status: Výzkum dokončen.\n\nPOPIS VÝZKUMU: Od prvního dne mimozemské invaze se lidstvo pokouší odpovědět na jedinou otázku.\nKdo těmto bytostem skutečně velí?\nDosavadní výzkumy odhalily rozsáhlou a mimořádně složitou strukturu invazních sil.\nŠediváci představují technologicky vyspělý druh schopný zajišťovat průzkum, koordinaci a vedení menších operací.\nJeštěřani tvoří těžkou pěchotu pocházející z přirozeně vyvinuté válečnické civilizace.\nBijci pravděpodobně zastávají významné postavení v mocenské a vojenské hierarchii invaze.\nLeviti, Ohaři a další biologické organismy představují specializované nástroje určené k zastrašování, likvidaci nepřátel a ničení infrastruktury.\nMysloději pak disponují schopnostmi, které jim umožňují ovládat vědomí, koordinovat celé formace a manipulovat s okolním prostorem.\nDlouhou dobu se předpokládalo, že právě Mysloději představují nejvyšší velitelskou autoritu.\nVýsledky společné analýzy všech dosud získaných poznatků však tento předpoklad zásadně zpochybnily.\nMysloději nejsou nejvyššími vládci invaze.\nJsou jejími prostředníky.\n\nOBJEV CENTRÁLNÍHO PSIONICKÉHO SPOJENÍ: Zásadní průlom přinesla opětovná analýza nervové tkáně několika získaných Myslodějů.\nBěhem původních pitev byly identifikovány specializované nervové struktury označované jako psionické uzly.\nTyto útvary umožňují mimořádně pokročilou mentální komunikaci, ovládání jiných organismů a manipulaci s fyzickým prostředím.\nPři podrobnějším zkoumání však výzkumníci objevili neobvyklou vlastnost.\nUrčité části mozku všech získaných Myslodějů vykazovaly téměř totožnou nervovou organizaci.\nZpočátku se předpokládalo, že jde pouze o přirozenou anatomickou vlastnost jejich druhu.\nNásledná analýza však odhalila něco mnohem závažnějšího.\nVšechny zkoumané exempláře vykazovaly shodný psionický synchronizační vzorec.\nTento vzorec nebyl závislý na individuálních anatomických rozdílech ani na rozsahu poškození nervové tkáně.\nJeho struktura odpovídala neustále opakovanému procesu přijímání a zpracování informací.\nVýzkumníci dospěli k závěru, že Mysloději pravděpodobně nejsou zcela nezávislými veliteli.\nJejich nervové systémy jsou propojeny prostřednictvím rozsáhlé psionické komunikační sítě.\nA tato síť zřejmě disponuje jediným centrálním zdrojem.\n\nANALÝZA PSIONICKÉ HIERARCHIE: Porovnáním neurologických dat Myslodějů s poznatky získanými z komunikačních systémů Diskollů a velitelských zařízení dalších mimozemských jednotek se podařilo vytvořit první ucelený model invazního velení.\nZískané výsledky naznačují následující strukturu:\nPrvní úroveň - Bojové a biologické jednotky\nJednotlivé organismy vykonávají základní bojové, průzkumné a podpůrné úkoly.\nČást z nich disponuje vlastní inteligencí, zatímco jiné jsou řízeny technologickými nebo neurologickými prostředky.\nDruhá úroveň - Taktické velení\nŠediváci Velitelé, Bijci Velitelé a další specializované jednotky koordinují menší bojové formace.\nDisponují značnou autonomií při rozhodování.\nTřetí úroveň - Strategické velení\nMysloději zajišťují rozsáhlou koordinaci invazních sil.\nJejich psionické schopnosti umožňují přenášet informace a rozkazy mezi jednotlivými druhy, technologickými systémy a velkými vojenskými formacemi.\nČtvrtá úroveň - Centrální mysl\nNově identifikovaný, dosud neznámý zdroj psionických signálů.\nPravděpodobně představuje nejvyšší koordinační autoritu celé invaze.\nVýzkumníci předpokládají, že tento zdroj dokáže současně komunikovat s velkým množstvím Myslodějů a prostřednictvím jejich schopností ovlivňovat rozsáhlé invazní operace.\nInvaze tak pravděpodobně není řízena soustavou vzájemně nezávislých velitelů, ale jediným centrálním vědomím.\n\nHYPOTÉZA CENTRÁLNÍ MYSLI: Objev společného psionického propojení vyvolává řadu zásadních otázek.\nJe centrální mysl samostatným biologickým organismem?\nJde o mimořádně vyspělou umělou inteligenci?\nNebo o zcela neznámou formu vědomí, která dokáže existovat mimo běžné biologické struktury?\nDosavadní výzkum neumožňuje jednoznačnou odpověď.\nAnalýza neurologických vzorců však naznačuje, že centrální zdroj nevysílá pouze jednoduché rozkazy.\nPřenášené informace obsahují komplexní rozhodovací struktury, strategické priority a pravděpodobně také úpravy chování jednotlivých velitelů.\nCentrální mysl tak zřejmě nedohlíží pouze na invazi. Aktivně rozhoduje o jejím průběhu.\nMysloději mohou fungovat jako biologické zesilovače jejího vědomí.\nPřijímají strategické instrukce, zpracovávají místní informace a následně předávají rozkazy podřízeným jednotkám.\nTento mechanismus by vysvětloval mimořádnou koordinaci mimozemských armád, které dokážou současně operovat na několika kontinentech.\nZároveň by mohl objasnit, proč se tak biologicky a kulturně odlišné druhy dokážou účastnit jediné rozsáhlé vojenské operace bez výraznějších známek organizačního chaosu.\n\nNEZÁVISLOST JEDNOTLIVÝCH RAS: Přestože centrální mysl pravděpodobně představuje vrchol invazního velení, dostupné poznatky nenaznačují, že by všechny mimozemské organismy byly neustále přímo ovládány.\nJeštěřani a Bijci disponují vlastní inteligencí a rozhodovacími schopnostmi.\nŠediváci vykazují značnou technologickou a organizační autonomii.\nNěkteré biologické organismy reagují na jednoduché neurologické povely nebo přirozené instinkty.\nZdá se tedy, že centrální mysl neřídí každý jednotlivý pohyb všech invazních jednotek.\nNamísto toho vytváří jednotnou strategii, kterou prostřednictvím Myslodějů a dalších velitelských struktur prosazuje.\nTato skutečnost naznačuje, že invaze může být tvořena několika samostatnými civilizacemi, jejichž činnost je sjednocena společnou autoritou.\nDosud není známo, zda jednotlivé rasy této autoritě slouží dobrovolně, na základě mocenských dohod, nebo v důsledku přímého mentálního podrobení.\n\nREKONSTRUKCE PSIONICKÉHO SIGNÁLU: Nejvýznamnější část výzkumu představovala rekonstrukce zbytkových nervových vzorců nalezených v mozcích Myslodějů.\nPůvodní laboratorní analýza předpokládala, že jde o biologické projevy související s mentální komunikací.\nPo propojení dat ze všech dostupných exemplářů se však podařilo identifikovat pravidelně se opakující strukturu.\nTato struktura obsahovala synchronizační impulzy, které se vyskytovaly u všech Myslodějů bez ohledu na místo jejich zneškodnění.\nVýzkumníci proto zahájili experimentální modelování možného zdroje těchto impulzů.\nVýsledky ukázaly, že pozorované vzorce nevznikaly nezávisle v jednotlivých mozcích.\nJejich časové a strukturální vztahy odpovídaly působení jediného vzdáleného zdroje.\nNěkdo nebo něco vysílá Myslodějům rozkazy.\nZvláštní pozornost zasluhuje skutečnost, že signál vykazuje mimořádnou stabilitu.\nNení zřejmé, že by byl přímo závislý na pozemských komunikačních prostředcích nebo běžné elektromagnetické infrastruktuře.\nPři počátečních pokusech o určení směru jeho původu se navíc objevila anomálie.\nDostupná data nebyla dobře slučitelná s představou, že zdroj leží na povrchu Země.\nPřesné určení původu však zatím není možné.\n\nSTRATEGICKÉ DŮSLEDKY OBJEVU: Pokud je hypotéza centrální mysli správná, může představovat zásadní slabinu celé invaze.\nDosavadní vojenská strategie Projektu X byla založena především na likvidaci nepřátelských jednotek, narušování logistických tras a postupném získávání technologické převahy.\nObjev společného psionického velení však otevírá zcela novou možnost.\nPokud se podaří identifikovat a vyřadit centrální mysl, může dojít k rozsáhlému narušení velení celé invazní armády.\nZatím však nelze určit, jak výrazný by tento účinek byl.\nInteligentní druhy jako Bijci, Ještěřani a Šediváci by pravděpodobně dokázaly pokračovat v samostatných bojových operacích.\nBiologické jednotky závislé na neurologické kontrole by však mohly ztratit koordinaci nebo přejít k nekontrolovanému chování.\nMysloději by pravděpodobně přišli o společné strategické propojení.\nJe rovněž možné, že centrální mysl disponuje záložními velitelskými strukturami.\nZničení centrálního zdroje proto nemusí automaticky znamenat konec invaze. Může však představovat první skutečnou možnost, jak narušit její jednotné velení.\n\nNEZODPOVĚZENÉ OTÁZKY: Výzkumný tým nedokázal jednoznačně určit několik zásadních skutečností.\n- Jaká je biologická nebo technologická podstata centrální mysli?\n- Kde se centrální zdroj nachází?\n- Jakým mechanismem dokáže komunikovat se všemi Mysloději?\n- Je tento zdroj jediný, nebo existují další propojená vědomí?\n- Lze psionický signál narušit bez přímého zničení jeho zdroje?\n- Jak by jednotlivé mimozemské rasy reagovaly na ztrátu centrálního velení?\nOdpovědi na tyto otázky mohou zásadně změnit další průběh války.\n\nNOVÝ VÝZKUM – URČENÍ ZDROJE SIGNÁLU: Rekonstrukce psionického propojení umožnila vytvořit první experimentální model vzdálené mentální komunikace.\nTechnologické oddělení navrhuje využít získaná data k vývoji specializovaného detekčního systému schopného analyzovat původ psionických impulzů.\nJeho cílem nebude pouze zachytit přítomnost signálu, ale také určit směr a vzdálenost jeho zdroje.\nVýzkumníci se domnívají, že při dostatečně přesném měření by mohlo být možné identifikovat oblast, z níž centrální mysl koordinuje invazi.\nDoporučení vrchnímu velení: Okamžitě schválit samostatný výzkumný projekt zaměřený na lokalizaci centrálního psionického zdroje.\n\nSTRATEGICKÉ ZÁVĚRY VÝZKUMU: - Potvrzený poznatek: Mozky získaných Myslodějů vykazují společný psionický synchronizační vzorec.\n- Potvrzený poznatek: Mysloději tvoří součást rozsáhlé mentální komunikační sítě.\n- Zásadní hypotéza: Síť je pravděpodobně řízena jediným centrálním vědomím.\n- Nový strategický poznatek: Mysloději nejsou konečnou autoritou invaze, ale prostředníky vyšší velitelské struktury.\n- Možná slabina invaze: Narušení centrálního zdroje by mohlo způsobit ztrátu koordinace významné části nepřátelských sil.\n- Nevyřešená otázka: Přesná poloha a skutečná podstata centrální mysli zůstávají neznámé.\n- Výzkumný potenciál: Psionická triangulace, detekce vzdálených mentálních signálů a vývoj strategických psionických rušiček.\nDoporučený další postup: Pokračovat v analýze psionických signálů a vyvinout prostředky pro určení jejich původu. Do potvrzení polohy centrální mysli nezahajovat žádné přímé strategické operace proti předpokládanému zdroji.\n\nZÁVĚREČNÉ HODNOCENÍ: \"Mysleli jsme, že jsme to konečně pochopili.\nŠediváci jsou jejich vědci a průzkumníci. Ještěřani jejich těžká pěchota. Bijci jejich válečníci a velitelé.\nLeviti, Ohaři a další zrůdy jsou jen nástroje.\nA Mysloději?\nTi měli být na vrcholu.\nBylo to logické. Ovládají mysl. Dokážou přikazovat jiným bytostem. Jsou schopni koordinovat celé armády.\nJenže jsme se mýlili.\nZnovu jsme otevřeli jejich neurologické záznamy.\nZkoumali jsme každý nervový uzel, každý zaznamenaný impulz, každou anomálii.\nA pak jsme našli něco, co tam nemělo být.\nStejný vzorec.\nV každém jednom mozku.\nNe podobný. Stejný.\nJako by všichni poslouchali jediný hlas.\nNejdřív jsme tomu odmítali uvěřit.\nPak jsme spojili všechna data.\nA najednou se před námi objevila struktura.\nObrovská, dokonale propojená síť.\nKaždý Mysloděj představoval jeden uzel. Každý uzel přijímal informace, vyhodnocoval je a předával dál.\nAle všechny tyto uzly měly jedno společné.\nSměřovaly k jedinému zdroji.\nPánové...\nCelou dobu jsme si mysleli, že bojujeme proti armádě složené z mnoha ras.\nAle co když ve skutečnosti bojujeme proti jedinému vědomí?\nCo když všechny ty lodě, všechny útoky, všechny únosy a všechny ty biologické hrůzy nejsou rozhodnutími stovek různých velitelů?\nCo když je to všechno jen jeden plán?\nJedna vůle.\nJedna mysl.\nVíte, co je na tom nejděsivější?\nŽe ten zdroj stále existuje.\nNěkde tam venku.\nA podle všeho o nás ví.\nO našich armádách. O našich základnách. O každé bitvě, kterou jsme vyhráli nebo prohráli.\nAle máme také důvod k naději.\nPoprvé od začátku invaze totiž víme, že někde existuje něco, na co se můžeme zaměřit.\nUž nemusíme jen bojovat proti nekonečným vlnám nepřátel.\nMožná konečně dokážeme najít toho, kdo je posílá.\nAž ho najdeme, budeme mít možnost zasadit invazi úder přímo do jejího srdce.\nJen musíme zjistit jednu věc.\nKde se ta zatracená mysl ukrývá?\"\n— Vedoucí neuropsionického výzkumu Projektu X, závěrečná strategická zpráva UAI"]
## 0.57: the last research (Ari) - it finds the central mind on Mars and opens the final mission
const RUDA := ["Rudá planeta", "VOJENSKÁ DATABÁZE - PROJEKT X\nZÁVĚREČNÝ STRATEGICKÝ VÝZKUM\nVýzkumný projekt: RUDÁ PLANETA.\nKlasifikace: Lokalizace centrálního psionického velení / strategická protiofenziva.\nOznačení projektu: X-OMEGA-002.\nStupeň utajení: ABSOLUTNÍ - OMEGA.\nVýzkumné oddělení: Společný výzkumný tým UAI, oddělení neuropsioniky, astrofyziky a meziplanetárních operací.\nStatus: Výzkum dokončen.\nPriorita: NEJVYŠŠÍ - EXISTENČNÍ OHROŽENÍ LIDSTVA.\n\nPOPIS VÝZKUMU: Od počátku mimozemské invaze se lidstvo nachází v téměř beznadějné situaci.\nNavzdory obrovskému úsilí armád celého světa, technologickým průlomům a statečnosti vojáků Projektu X se nepodařilo invazní síly definitivně zastavit.\nKaždé zničené plavidlo je nahrazeno dalším.\nKaždá osvobozená oblast se dříve či později stává cílem nového útoku.\nZtráty nepřítele se zdají být bezvýznamné ve srovnání s množstvím jednotek, kterými invaze disponuje.\nVýzkum označený jako \"Kdo stojí za invazí?\" však konečně odhalil možnou příčinu této mimořádné organizovanosti.\nCelá invaze je koordinována prostřednictvím rozsáhlé psionické sítě, jejímž centrem je dosud neidentifikované vědomí.\nMysloději fungují jako prostředníci této sítě. Přijímají strategické instrukce, koordinují invazní formace a předávají rozkazy ostatním jednotkám.\nDosud však nebylo možné určit, odkud tyto instrukce přicházejí.\nTeprve propojením neuropsionického výzkumu s novými meziplanetárními technologiemi se podařilo dosáhnout průlomu.\nCentrální psionický signál nepřichází z jiné hvězdné soustavy.\nNepřichází ani z žádného plavidla na oběžné dráze Země.\nJeho zdroj se nachází na Marsu.\n\nOBJEV – SIGNÁL Z RUDÉ PLANETY: Po dokončení výzkumu Myslodějů zahájilo neuropsionické oddělení rozsáhlou analýzu všech zaznamenaných mentálních impulzů.\nPomocí experimentálních detektorů, nových výpočetních systémů a údajů získaných z ukořistěné mimozemské technologie se podařilo rekonstruovat základní strukturu centrálního signálu.\nPrvní výsledky byly považovány za chybu měření.\nSignál totiž vykazoval pravidelné změny odpovídající pohybu vzdáleného astronomického objektu.\nVýzkumníci následně porovnali získaná data s polohami planet Sluneční soustavy.\nPo několika nezávislých měřeních byl výsledek jednoznačný.\nZdroj signálu sledoval pohyb čtvrté planety od Slunce.\nMarsu.\nDalší pozorování potvrdila, že nejsilnější koncentrace psionické aktivity pochází z oblasti hluboko pod jeho povrchem.\nVýzkumný tým tak poprvé identifikoval pravděpodobné umístění centrální mysli celé mimozemské invaze.\n\nCO SE SKRÝVÁ POD POVRCHEM MARSU: Dostupná data naznačují existenci rozsáhlé podzemní struktury, jejíž skutečné rozměry zatím nebylo možné určit.\nNěkteré geologické anomálie odpovídají dutinám a pravidelně uspořádaným prostorům, které pravděpodobně nevznikly přirozenou cestou.\nZachycené energetické projevy navíc naznačují přítomnost vysoce výkonných technologických zařízení.\nVšechny tyto poznatky podporují hypotézu, že se pod povrchem Marsu nachází rozsáhlý mimozemský komplex.\nJeho účel zatím není zcela znám.\nVýzkumníci však předpokládají, že může obsahovat:\n- Centrální psionické jádro odpovědné za koordinaci invaze.\n- Rozsáhlou síť zesilovačů a komunikačních uzlů.\n- Energetické systémy napájející celou strukturu.\n- Obranná zařízení a posádku chránící centrální vědomí.\n- Technologii umožňující přenos psionických rozkazů na meziplanetární vzdálenosti.\nZůstává nejasné, zda centrální mysl představuje jediný biologický organismus, kolektivní vědomí nebo pokročilou kombinaci biologické a strojové inteligence.\nJedno však víme.\nCelá tato struktura musí být pro invazi mimořádně důležitá.\n\nHISTORICKÁ SOUVISLOST – MARS: Mars fascinuje lidstvo již po staletí.\nJeho červený povrch, polární čepičky a rozsáhlé geologické útvary vedly ke vzniku nesčetných teorií o existenci mimozemského života.\nNa přelomu devatenáctého a dvacátého století dokonce někteří astronomové spekulovali o existenci umělých kanálů na jeho povrchu.\nPozdější kosmický výzkum tyto představy vyvrátil.\nAutomatické sondy odhalily pustý svět s řídkou atmosférou, nízkými teplotami a rozsáhlými pouštěmi.\nLidstvo postupně přijalo představu, že Mars je především mrtvou planetou.\nSoučasný objev však tuto jistotu zásadně narušuje.\nJe možné, že naše průzkumné sondy po celou dobu pozorovaly pouze prázdný povrch, zatímco skutečná aktivita se odehrávala hluboko pod ním.\nNení známo, jak dlouho mimozemský komplex existuje.\nMohl být vybudován krátce před zahájením invaze.\nStejně tak však mohl být na Marsu ukryt po staletí, nebo dokonce tisíciletí.\nPokud druhá možnost odpovídá skutečnosti, nabízí se znepokojivá otázka.\nBylo lidstvo pozorováno dávno předtím, než samo dokázalo opustit vlastní planetu?\n\nPROJEKT PELIKÁN – NAŠE JEDINÁ MOŽNOST: Ještě před několika měsíci by byl útok na mimozemské zařízení na Marsu zcela nemyslitelný.\nLidstvo nedisponovalo vojenským plavidlem schopným dopravit ozbrojenou jednotku na jinou planetu a zajistit její následný návrat.\nVývoj hybridního transportního plavidla UAI XT-87 \"Pelikán\" však tuto situaci změnil.\nPelikán kombinuje lidské letecké technologie s reverzně vyvinutým mimozemským pohonem.\nDisponuje schopností meziplanetárního letu, pokročilými navigačními systémy a dostatečně velkým nákladovým prostorem pro přepravu specializovaného bojového družstva včetně potřebného vybavení.\nJe tak prvním plavidlem Projektu X, které může uskutečnit vojenskou operaci mimo Zemi.\nJeho obranná výzbroj je však omezená.\nJediná automatizovaná obranná věž řízená umělou inteligencí nedokáže zaručit bezpečnost při střetu s početně silnějšími mimozemskými plavidly.\nPelikán není bitevní loď.\nJe transportérem.\nPokud bude během meziplanetární operace zničen, lidstvo může přijít o svou jedinou bezprostřední možnost zasáhnout centrální mysl.\nNavrhovaná mise proto vyžaduje mimořádně pečlivou přípravu, dostatečné zásoby a nasazení nejzkušenějších vojáků Projektu X.\n\nSTRATEGICKÁ HYPOTÉZA – ZNIČENÍ CENTRÁLNÍ SÍTĚ: Výzkum psionického propojení odhalil zásadní skutečnost.\nMimozemská invaze se skládá z mnoha biologicky i technologicky odlišných jednotek.\nJejich schopnost spolupracovat však do značné míry závisí na jednotném velitelském systému.\nPokud by se podařilo vyřadit centrální psionickou síť, mohlo by dojít k rozsáhlému narušení tohoto systému.\nMysloději by ztratili spojení s nadřízenou autoritou.\nČást biologických jednotek by mohla přestat přijímat řídicí impulzy.\nAutonomní bojové stroje by pravděpodobně pokračovaly podle posledních známých instrukcí.\nInteligentní druhy, jako jsou Šediváci, Ještěřani nebo Bijci, by si zachovaly vlastní rozhodovací schopnosti.\nJejich armády by však mohly ztratit strategickou koordinaci a jednotné velení.\nTo by mohlo otevřít prostor pro rozpory mezi jednotlivými rasami, veliteli a mocenskými skupinami invaze.\nZničení centrální mysli tedy nemusí znamenat okamžité vítězství.\nNepřátelská plavidla nezmizí.\nJejich vojáci nesloží zbraně.\nBiologické organismy nepřestanou existovat.\nAle invaze může přijít o svou největší přednost.\nO schopnost jednat jako jediná dokonale koordinovaná síla.\n\nNÁVRH OPERACE – RUDÁ PLANETA: Operační označení: POSLEDNÍ ÚSVIT\nPrimární cíl: Lokalizovat a zničit centrální psionickou síť.\nSekundární cíl: Potvrdit povahu centrální mysli a získat dostupné strategické informace.\nTřetí cíl: Zajistit návrat přeživšího personálu na Zemi.\nVrchní velení navrhuje následující operační postup.\n\nFÁZE I – ODLET: Pelikán s vybraným bojovým družstvem Projektu X opustí Zemi.\nPosádka bude vybavena nejpokročilejší dostupnou výzbrojí, ochrannými prostředky a psionickými rušiči.\nVzhledem k omezené kapacitě plavidla nebude možné nasadit rozsáhlé pozemní síly.\nOperace musí být provedena malou, vysoce specializovanou jednotkou.\n\nFÁZE II – PŘÍLET K MARSU: Pelikán zahájí průzkum předpokládané oblasti zdroje psionického signálu.\nPrioritou bude nalezení bezpečné přistávací zóny a identifikace možných vstupů do podzemního komplexu.\nJe nutné počítat s přítomností mimozemských obranných systémů.\n\nFÁZE III – PRŮNIK: Pozemní družstvo pronikne do mimozemského zařízení.\nPředpokládá se přítomnost biologických stráží, autonomních obranných strojů a pokročilých bezpečnostních systémů.\nVzhledem k významu zařízení nelze vyloučit nasazení dosud neidentifikovaných nepřátelských jednotek.\n\nFÁZE IV – CENTRÁLNÍ JÁDRO: Po lokalizaci hlavního psionického uzlu se družstvo pokusí vyřadit zařízení odpovědné za propojení centrální mysli s invazními silami.\nPřesný způsob zničení bude záviset na konstrukci objektu a dostupných technologických možnostech.\n\nFÁZE V – EVAKUACE: Po úspěšném vyřazení centrální sítě musí družstvo opustit objekt a vrátit se k Pelikánovi.\nNelze vyloučit, že zničení psionického jádra vyvolá rozsáhlou energetickou nestabilitu nebo automatickou aktivaci obranných systémů.\n\nHODNOCENÍ RIZIK: Navrhovaná operace představuje nejnebezpečnější vojenský podnik v dosavadní historii Projektu X.\nNepřátelské síly pravděpodobně disponují výraznou technologickou a početní převahou.\nV případě poškození Pelikána nebude možné zajistit rychlou pomoc ani evakuaci z povrchu Marsu.\nZtráta spojení se Zemí může znamenat úplnou izolaci družstva.\nNejvětším neznámým však zůstává samotná centrální mysl.\nPokud její psionické schopnosti převyšují schopnosti jednotlivých Myslodějů, může se družstvo setkat s mentálním ohrožením, proti kterému současná ochranná technologie nemusí být dostatečná.\nPravděpodobnost úspěchu nelze spolehlivě stanovit.\nPřesto strategické oddělení doporučuje operaci uskutečnit.\nPokračování současné obranné strategie totiž pravděpodobně povede k postupnému vyčerpání lidských zdrojů a konečné porážce.\n\nSTRATEGICKÉ ZÁVĚRY VÝZKUMU: - Potvrzený poznatek: Zdroj centrálního psionického signálu se nachází na Marsu.\n- Potvrzený poznatek: Signál vychází z oblasti pod povrchem planety.\n- Zásadní hypotéza: Na Marsu se nachází centrální velitelský komplex celé invaze.\n- Nový strategický cíl: Vyřazení centrální psionické sítě.\n- Dostupný prostředek: Meziplanetární transportní plavidlo Pelikán.\n- Hlavní riziko: Neznámá obrana komplexu, technologická převaha nepřítele a omezené možnosti evakuace.\n- Možný výsledek: Rozpad jednotného strategického velení invaze a vznik příležitosti k celosvětové lidské protiofenzivě.\nRozhodnutí vrchního velení UAI: Schválit přípravu operace POSLEDNÍ ÚSVIT.\n\nZÁVĚREČNÉ HODNOCENÍ: \"Dámy a pánové.\nPřed několika měsíci jsme nevěděli prakticky nic.\nNeznali jsme jejich původ. Nerozuměli jsme jejich zbraním. Nedokázali jsme vysvětlit jejich technologie.\nKaždý den jsme přicházeli o další města. Další vojáky. Další životy.\nNaše armády ustupovaly a naše vlády se hroutily.\nZatímco jsme se snažili pochopit, co se vlastně děje, oni pokračovali v útoku.\nPak vznikl Projekt X.\nZačali jsme zkoumat jejich těla. Jejich stroje. Jejich zbraně.\nZjistili jsme, že Šediváci jsou fyzicky slabí, ale technologicky mimořádně vyspělí.\nZjistili jsme, že jejich biologické zbraně nejsou neporazitelné.\nZjistili jsme, že ani jejich nejsilnější válečníci nejsou nezranitelní.\nA nakonec jsme objevili Mysloděje.\nBytosti schopné ovládat naše myšlenky. Přinutit naše vlastní vojáky obrátit zbraně proti sobě. Přemístit se pouhou silou své mysli.\nMysleli jsme, že právě oni jsou naším skutečným nepřítelem.\nAle nebyli.\nByli pouze součástí něčeho mnohem většího.\nObrovské psionické sítě, která propojuje celé invazní síly.\nA dnes vám mohu konečně oznámit, že jsme našli její zdroj.\nMars.\nTa zatracená rudá planeta, na kterou jsme se po staletí dívali dalekohledy.\nCelou dobu jsme hledali život tam nahoře.\nA teď víme, že právě odtamtud přicházejí rozkazy, které zabíjejí naše lidi.\nDámy a pánové, máme jeho polohu.\nMáme jeho slabinu.\nA díky našim inženýrům máme konečně i prostředek, jak se tam dostat.\nPelikán.\nPrvní lidské vojenské plavidlo schopné meziplanetárního letu.\nNení dokonalý. Není nezničitelný. A rozhodně z něj nemůžeme udělat celou invazní flotilu.\nAle dokáže tam doletět.\nA dokáže tam dopravit naše vojáky.\nTeď vám ovšem musím říct něco, co se vám nebude líbit.\nNemáme žádnou jistotu, že se vrátí.\nNevíme, co na Marsu najdou.\nNevíme, jak vypadá centrální mysl.\nA nevíme, jestli její zničení skutečně ukončí invazi.\nAle jednu věc víme naprosto jistě.\nPokud neuděláme nic, prohrajeme.\nMožná za rok. Možná za deset let.\nAle prohrajeme.\nNaše města budou zničena. Naše civilizace rozebrána. A ti, kteří přežijí, budou zotročeni nebo využiti pro jejich experimenty.\nUž jsme viděli, co dokážou udělat s lidským tělem.\nVíme, co se stalo lidem, jejichž genetický materiál skončil v jejich zrůdách.\nA já odmítám připustit, aby takhle skončilo celé lidstvo.\nProto navrhuji poslední operaci.\nNejodvážnější a nejnebezpečnější vojenskou operaci v historii našeho druhu.\nPošleme naše nejlepší vojáky na Mars.\nNajdou tu věc.\nA zničí ji.\nMožná tím válka neskončí.\nMožná budeme muset bojovat další roky.\nAle pokud se nám podaří přerušit jejich centrální velení, konečně dostaneme něco, co nám od prvního dne invaze chybělo.\nŠanci.\nŠanci znovu vybojovat naši planetu.\nŠanci zachránit naše rodiny.\nŠanci rozhodovat o vlastní budoucnosti.\nCelé dějiny jsme hleděli ke hvězdám a přemýšleli, co tam na nás čeká.\nDnes už to víme.\nA dnes jim konečně odpovíme.\nNe jako otroci.\nNe jako kořist.\nAle jako lidé.\nPřipravte Pelikána.\nJe čas ukončit tuhle zatracenou invazi.\"\n— Vrchní velitel Projektu X, mimořádné zasedání nejvyššího velení UAI\n\nROZHODNUTÍ VELITELSTVÍ: OPERACE SCHVÁLENA\nCÍLOVÁ PLANETA: MARS\nOPERAČNÍ OZNAČENÍ: POSLEDNÍ ÚSVIT\nPRIMÁRNÍ CÍL: ZNIČENÍ CENTRÁLNÍ PSIONICKÉ SÍTĚ\nSTAV: ČEKÁ NA ROZKAZ K ODLETU"]

## 0.57: entries whose item has no model of its own show a close one (empty picture otherwise).
const ITEM_MODEL := {"slugs": "round", "beanbag": "round", "rocket_ap": "rocket", "rocket_inc": "rocket"}
const EXTRA_MODEL := {"jet_laser": "jet_laser_mg", "jet_laser_cannon": "jet_laser_cannon"}

## All entries, in order: [{id, cat, title, text, model, view, unlock}].
static func entries() -> Array:
	var out := []
	for r in Campaign.RACE_INFO:
		var model: String = r
		out.append({"id": "race_" + r, "cat": "Vetřelci", "title": Campaign.RACE_INFO[r][0], "text": Campaign.RACE_INFO[r][1],
			"model": model, "view": "stand", "unlock": "seen:" + r, "icon": "race_" + r})
	for r in AUTOPSY:
		var a: Array = AUTOPSY[r]
		var machine: bool = r in ["diskoll", "kolos"]
		out.append({"id": "autopsy_" + r, "cat": "Pitvy a výslechy", "title": ("Rozbor: " if machine else "Pitva: ") + Campaign.race_name(r), "text": a[1],
			"model": r, "view": "table", "unlock": "res:" + a[0], "icon": "race_" + r})
	out.append({"id": "lore_vyslech", "cat": "Pitvy a výslechy", "title": "Výslech zajatce", "text": INTERROGATION_GREY,
		"model": "grey", "view": "stand", "unlock": "res:vyslech", "icon": "race_grey"})
	out.append({"id": "vyslech_velitel", "cat": "Pitvy a výslechy", "title": "Výslech velitele", "text": INTERROGATION,
		"model": "grey_velitel", "view": "stand", "unlock": "res:vyslech_velitel", "icon": "race_grey_velitel"})
	for u in UFO:
		out.append({"id": u, "cat": "Stroje a lodě vetřelců", "title": UFO[u][0], "text": UFO[u][1], "model": u, "view": "craft", "unlock": UFO[u][2], "icon": u})
	for it in ITEM_TEXT:
		var unlock: String = "loot:" + it if it.begins_with("a_") else ("res:" + Campaign.LOCKED_BY[it] if Campaign.LOCKED_BY.has(it) else "start")
		out.append({"id": "item_" + it, "cat": "Zbraně a výbava", "title": Game.ITEMS[it]["name"], "text": ITEM_TEXT[it] + card(it), "model": ITEM_MODEL.get(it, it), "view": "item", "unlock": unlock, "icon": it})
	# the kit every soldier wears (no item of its own)
	out.append({"id": "item_vystroj", "cat": "Zbraně a výbava", "title": "Bojová výstroj UAI", "text": VYSTROJ, "model": "merc", "view": "stand", "unlock": "start", "icon": "vesta"})
	for c in CRAFT:
		out.append({"id": "craft_" + c, "cat": "Naše letadla", "title": CRAFT[c][0], "text": CRAFT[c][1], "model": c if c != "orel" else "pelikan", "view": "craft", "unlock": CRAFT[c][2], "icon": c if c != "orel" else "pelikan"})
	out.append({"id": "lore_soud", "cat": "Objevy", "title": SOUD[0], "text": SOUD[1], "model": "grey", "view": "stand", "unlock": "start", "icon": "race_grey"})
	out.append({"id": "lore_kdo", "cat": "Objevy", "title": WHO[0], "text": WHO[1], "model": "myslodej", "view": "stand", "unlock": "res:kdo_invaze", "icon": "race_myslodej"})
	out.append({"id": "lore_ruda", "cat": "Objevy", "title": RUDA[0], "text": RUDA[1], "model": "mars_hq", "view": "stand", "unlock": "res:ruda_planeta", "icon": "mars"})
	for k in EXTRA:
		var x: Array = EXTRA[k]
		var u: String = x[3]
		var icon := ""
		if u.begins_with("fac:"):
			var f := u.substr(4)
			u = "res:" + Campaign.FACILITY_RES[f] if Campaign.FACILITY_RES.has(f) else "start"
		else:
			icon = String(Campaign.RESEARCH.get(u.substr(4), {}).get("icon", ""))
		out.append({"id": "extra_" + k, "cat": x[0], "title": x[1], "text": x[2], "model": EXTRA_MODEL.get(k, ""), "view": "item" if EXTRA_MODEL.has(k) else "stand", "unlock": u, "icon": icon})
	for k in LORE:
		var l: Array = LORE[k]
		out.append({"id": "lore_" + k, "cat": "Objevy", "title": l[0], "text": l[1], "model": l[3], "view": "item" if l[3] in ["plasma_cell", "a_pack", "a_pistol", "laser_rifle", "plasma_rifle"] else "stand",
			"unlock": "res:" + k, "icon": ""})
	return out

## Is an entry open to the team?
static func unlocked(e: Dictionary) -> bool:
	if not Campaign.active and not Campaign.viewer:
		return true            # outside a campaign (menu): everything
	var u := String(e["unlock"])
	if u == "start":
		return true
	var k := u.get_slice(":", 0)
	var v := u.get_slice(":", 1)
	if u == "allres":
		for rid in Campaign.RESEARCH:
			if not Campaign.researched(rid):
				return false
		return true
	match k:
		"seen": return v in Campaign.data.get("seen_races", []) or (v == "levit_velitel" and false)
		"res": return Campaign.researched(v)
		"loot": return int(Campaign.data.get("found", {}).get(v, 0)) > 0
		"missions": return int(Campaign.data.get("stats", {}).get("missions", 0)) >= int(v)
	return false

## The entry (if any) a research project opens.
static func for_research(id: String) -> String:
	for e in entries():
		if String(e["unlock"]) == "res:" + id:
			return String(e["id"])
	return ""
