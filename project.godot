; Engine configuration file.
config_version=5

[application]

config/name="Enemy Beyond"
config/description="Fanouškovská pocta UFO: Enemy Unknown - kooperativní taktická střílečka."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://scripts/game.gd"
Net="*res://scripts/net.gd"
Campaign="*res://scripts/campaign.gd"

[audio]

driver/enable_input=true

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/default_font_antialiasing=1
theme/default_font_hinting=1
theme/default_font_subpixel_positioning=1

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
rendering_device/fallback_to_opengl3=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=48
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.04, 1)

[shader_globals]

wind_strength={
"type": "float",
"value": 1.0
}
